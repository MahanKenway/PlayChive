// wrangler.jsonc
// PLAYCHIVE is a purely static site. The dist/ folder is generated by the
// GitHub Actions workflow (Emscripten builds) and uploaded as Workers Static Assets.
{
  "name": "playchive",
  "compatibility_date": "2025-03-07",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
