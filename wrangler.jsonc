// wrangler.jsonc
// PLAYCHIVE on Cloudflare Workers. The site itself is built by GitHub Actions
// and published to GitHub Pages; this Worker serves it from Cloudflare's edge
// (see worker/index.ts), so no build step is needed on Cloudflare.
{
  "name": "playchive",
  "main": "worker/index.ts",
  "compatibility_date": "2025-03-07",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
