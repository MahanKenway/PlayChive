    "#featured",
    "#catalog",
    "#crawlable-catalog",
    "#library",
    "#about"
  ],
  "selectors": {
    "catalog": "#catalog-grid",
    "crawlableCatalog": "#crawlable-catalog",
    "gameStatus": "#game-status",
    "launchLinks": "a[data-agent-action=launch-game]",
    "runtimeActions": "[data-agent-action]"
  },
  "agentActions": [
    "launch",
    "pause",
    "resume",
    "restart",
    "fullscreen",
    "return-to-hub",
    "press-key"
  ],
  "runtimeStates": [
    "loading",
    "ready",
    "playing",
    "paused",
    "error",
    "stopped"
  ],
